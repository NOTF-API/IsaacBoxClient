#include <windows.h>

1 VERSIONINFO
FILEVERSION 2,0,5,0
PRODUCTVERSION 2,0,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "IsaacBoxClient"
      VALUE "FileDescription", "IsaacBox game directory utility"
      VALUE "FileVersion", "2.0.5.0"
      VALUE "InternalName", "IsaacBoxUtility"
      VALUE "LegalCopyright", "Copyright (c) 2026 IsaacBoxClient"
      VALUE "OriginalFilename", "IsaacBoxUtility.exe"
      VALUE "ProductName", "IsaacBoxClient"
      VALUE "ProductVersion", "2.0.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "IsaacBoxUtility.manifest"
